# Ignore all PyTorch model weights
*.pth
*.pt

# Ignore PyCharm configuration files
.idea/

*.npy
*.env

!constrained_fm/benchmark/validation_set.pt

dummy_script.py
logs/
outputs/
__pycache__/

# Run artifacts: config/provenance/metrics stay under version control, figures do not.
# Checkpoints and loss histories are already covered by the *.pt / *.npy rules above.
runs/*/figures/

# Plotting artifacts: the bulk .npy tensors are already ignored above, while every
# artifacts/manifest.json is tracked so each figure stays traceable to a run and a commit.
!**/artifacts/manifest.json

# Per-item shard state for the few-shot baseline: resumability scratch, fully aggregated
# into summary.json which is tracked.
constrained_fm/baselines/*/results/
constrained_fm/baselines/*/samples/

!constrained_fm/functa_dataset/embed_best.pt
!constrained_fm/functa_dataset/loss_history.npy
!constrained_fm/functa_dataset/val_loss_history.npy
!constrained_fm/functa_dataset/siren_gmmq05.pt
!constrained_fm/functa_dataset/siren_uniform.pt

constrained_fm/functa_dataset/pools/
constrained_fm/improvements_docs/