   "source": [
    "\"lr = 1e-3\\n\",\n",
    "    \"batch_size = 1024\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Functa conditioning is a harder regression target than raw polynomial coefficients\\n\",\n",
    "    \"# (the model only sees an approximate learned z + the SIREN's own approximate\\n\",\n",
    "    \"# per-point prediction, not an exact analytic P(x)), so it needs a substantially\\n\",\n",
    "    \"# longer schedule to converge. Each iteration is cheap now (pool-based, no SIREN\\n\",\n",
    "    \"# calls), so a much larger budget is still fast.\\n\",\n",
    "    \"iterations = 15001\\n\",\n",
    "    \"print_every = 500\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Gaussian noise injected into each sampled z, scaled to the pool's own per-dimension\\n\",\n",
    "    \"# std. Regularizes the flow matcher to be locally smooth around each pool latent,\\n\",\n",
    "    \"# instead of overfitting to the exact stored z (which is itself a noisy CAVIA\\n\",\n",
    "    \"# extraction, not the shape's true identity), so it generalizes to the slightly\\n\",\n",
    "    \"# different z produced by a fresh out-of-pool extraction of the same shape.\\n\",\n",
    "    \"z_noise_frac = 0.1\\n\",\n",
    "    \"z_std = functa_pool[\\\"z_pos\\\"].std()\\n\",\n",
    "    \"\\n\",\n",
    "    \"vf_functa = ConstrainedFlowMatcher(siren=siren, latent_dim=latent_dim).to(device)\\n\",\n",
    "    \"path = AffineProbPath(scheduler=CondOTScheduler())\\n\",\n",
    "    \"optim_functa = torch.optim.Adam(vf_functa.trainable_parameters(), lr=lr)\\n\",\n",
    "    \"scheduler_functa = torch.optim.lr_scheduler.CosineAnnealingLR(optim_functa, T_max=iterations, eta_min=1e-5)\\n\",\n",
    "    \"\\n\",\n",
    "    \"losses_functa = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"for i in tqdm(range(iterations)):\\n\",\n",
    "    \"    optim_functa.zero_grad()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    x_1, _ = get_points(batch_size, device=device)\\n\",\n",
    "    \"    x_0 = torch.randn_like(x_1).to(device)\\n\",\n",
    "    \"    t = torch.rand(x_1.shape[0]).to(device)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    path_sample = path.sample(t=t, x_0=x_0, x_1=x_1)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # Free (no SIREN calls): sampled from the precomputed pool built above.\\n\",\n",
    "    \"    C, z = sample_from_functa_pool(path_sample.x_1, functa_pool, degree=poly_degree, scale=plane_scale)\\n\",\n",
    "    \"    z = z + torch.randn_like(z) * (z_noise_frac * z_std)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    pred_v = vf_functa(path_sample.x_t, path_sample.t, z)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    loss = torch.pow(pred_v - path_sample.dx_t, 2).mean()\\n\",\n",
    "    \"    loss.backward()\\n\",\n",
    "    \"    optim_functa.step()\\n\",\n",
    "    \"    scheduler_functa.step()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    losses_functa.append(loss.item())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    if (i + 1) % print_every == 0:\\n\",\n",
    "    \"        current_lr = optim_functa.param_groups[0]['lr']\\n\",\n",
    "    \"        print('| iter {:6d} | loss {:8.5f} | lr {:.2e}'.format(i + 1, loss.item(), current_lr))\\n\"\n"
   ]
  }
